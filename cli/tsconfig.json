{
  "include": [
    "src/**/*.ts",
  ],
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "esModuleInterop": true,
    "rootDir": "./src",
    "outDir": "dist",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "experimentalDecorators": true
  },
  "exclude": [
    "node_modules"
  ]
}